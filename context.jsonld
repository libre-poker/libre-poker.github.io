{
  "@context": {
    "@version": 1.1,
    "lp": "https://librepoker.org/ns#",
    "type": "@type",
    "Hand": "lp:Hand",
    "Match": "lp:Match",
    "Chain": "lp:Chain",
    "Tourney": "lp:Tourney",
    "Agent": "lp:Agent",
    "v": "lp:specVersion",
    "variant": "lp:variant",
    "seed": "lp:shuffleSeed",
    "sb": "lp:smallBlind",
    "bb": "lp:bigBlind",
    "ante": "lp:ante",
    "button": "lp:buttonSeat",
    "seats": { "@id": "lp:seats", "@container": "@list" },
    "name": "lp:seatName",
    "agent": "lp:declaredAgent",
    "startStack": "lp:startStack",
    "hole": { "@id": "lp:holeCards", "@container": "@list" },
    "board": { "@id": "lp:boardCards", "@container": "@list" },
    "actions": { "@id": "lp:actions", "@container": "@list" },
    "seat": "lp:actorSeat",
    "act": "lp:actKind",
    "to": "lp:raiseTo",
    "amount": "lp:chipAmount",
    "street": "lp:street",
    "result": "lp:result",
    "showdown": "lp:showdown",
    "pot": "lp:potTotal",
    "winners": { "@id": "lp:winners", "@container": "@list" },
    "annotations": { "@id": "lp:annotations", "@container": "@list" },
    "action": "lp:annotatedActionIndex",
    "mix": "lp:referenceMix",
    "evLossBb": "lp:evLossBigBlinds",
    "exact": "lp:exactSolve"
  }
}
